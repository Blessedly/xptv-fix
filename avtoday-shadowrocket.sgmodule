#!name=AVToday 播放修复
#!desc=为 AVToday 的 HLS 清单与视频分片补充防盗链请求头，并修正 TS 分片响应类型。
#!author=make

[Header Rewrite]
# avtoday.js 已给 m3u8 请求设置 Referer，这里将其统一为站点根地址。
http-request ^https:\/\/(?:www\.)?avtoday\.io\/streaming\/ header-replace Referer https://avtoday.io/

# XPTV 不会把 m3u8 的 Referer 自动传给子分片，需要在手机网络层补充。
http-request ^https:\/\/ss\.xdmm\.workers\.dev\/ header-add Referer https://avtoday.io/

# ss.xdmm.workers.dev 返回的是 MPEG-TS 数据，但响应类型是 application/octet-stream。
http-response ^https:\/\/ss\.xdmm\.workers\.dev\/ header-replace Content-Type video/mp2t

[MITM]
# 仅解密 AVToday 播放所需的两个域名，不扩大 HTTPS 解密范围。
hostname = %APPEND% avtoday.io, www.avtoday.io, ss.xdmm.workers.dev
