#!name=AVToday UA 修复
#!desc=为 AVToday 签名 MP4 补写固定 User-Agent，视频仍由手机直连，不经过中转。

[Script]
AVToday-UA = type=http-request, pattern=^https:\/\/video\.xdmm\.workers\.dev\/.*\.mp4(?:\?.*)?$, requires-body=0, timeout=10, engine=jsc, script-path=https://raw.githubusercontent.com/Blessedly/xptv-fix/main/shadowrocket/avtoday-ua.js?v=2026090902

[MITM]
hostname = %APPEND% video.xdmm.workers.dev
